<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Edu Posts</title>
        <link rel="stylesheet" href="style.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/vs2015.min.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
        <a href="index.html">Home</a>

        <h1>Educational Posts</h1>

        <p>A curated list of all the posts I made that <b>teach you something</b>. Yes this is mostly comprised of stuff from the Mod Devblog 🙃</p>

        <hr>

        <div class="devblog-container">
{%- for post in collections.eduPosts %}
            <a href="{{ post.url }}">
                <div class="devblog-item">
                    <img src="/nuke_mod_blog/{{ post.data.thumbnail }}">
                    <div class="devblog-text">
                        <div class="devblog-title-block">
                            <h1>{{ post.data.title | safe }}</h1>
                            <h3>{{ post.date | slashDate }}</h3>
                        </div>
                        <hr>
                        <p>{{ post.data.description | safe }}</p>
                    </div>
                </div>
            </a>
{%- endfor %}
        </div>
    </body>
</html>
